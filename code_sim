def surg_availability():
    surgeons=["Fotis","George","Nikos","Akis","Maria","Anastasis","Dimitris","Vasiliki"]
    avail=[]
    for surgeon in surgeons:
        status=choice(["Available","Unavailable"])
        avail.append([surgeon,status])
    count=0
    for row in avail:
        if row[1]=="Available":
            count=count+1
    return count


def rob_Rarm_movement(R_angle,min_angle,max_angle):
    if(R_angle>max_angle or R_angle<min_angle):
        print("Dangerous value of angle.")
        return False
    else:
        print("The value of angle is safe.")
        return True



def rob_Larm_movement(L_angle,min_angle,max_angle):
