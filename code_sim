class RoboticPart:

    def __init__(self,angle,is_func,temp):
        self.angle=angle
        self.is_func=is_func
        self.temp=temp

    def check_infos(self):
        if not((self.angle>0 and self.angle<90)):
            print("Angle problem")
            return False
        elif not(self.is_func==True):
            print("This robotic part is not functional")
            return False
        elif not(self.temp>0 and self.temp<=50):
            print("The temperature of this robotic arm is dangerous")
            return False
        else:
            print("We can proceed to the next part")
            return True



class SurgCamera:
    human_organs={"heart":0.25,"lungs":0.30,"brain":0.80,"liver":0.40}

    def __init__(self,is_on,I01,I02,b_level,fps,organ):    # i1 kai i2 gia to contrast
        self.is_on=is_on
        self.I01=I01
        self.I02=I02
        self.b_level=b_level
        self.fps=fps
        self.organ=organ


    def check_cam_infos(self):
        if not(self.is_on==True):
            print("Camera is not On")
            return False
        
        if (self.I01>0 and self.I02>0):    
            for organ in self.human_organs:
                if self.organ in self.human_organs:

                    I1=self.I01*exp(self.human_organs[self.organ])
                    I2=self.I02*exp(self.human_organs[self.organ])

                    Contrast=(abs(I1-I2)/I1)

                    if not(Contrast>0 and Contrast<=0.4375):
                        print("Dangerous value of contrast")
                        return False
                    
                else:
                    print("Organ not found")
                    return False
        else:
            print("Wrong radiation intensity values")
            return False

        if not(self.b_level>50):
            print("Battery levels too low")
            return False
        if not(self.fps>180):
            print("Fps too low")
            return False
        return True
        
